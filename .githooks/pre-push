#!/bin/sh
# main 직접 푸시를 막는다.
#
# 2026-09-06 저장소를 공개로 바꾼 뒤로는 GitHub branch protection도 쓸 수 있다(그 전에는 비공개 + 무료
# 플랜이라 403이었다). 서버가 막고 있으면 이 훅은 유일한 방어가 아니라 **빠른 방어**다 — 서버까지 갔다가
# 거절당하기 전에 막는다. 서버 보호가 꺼져 있으면(2026-10-02 확인 때 꺼져 있었다) 여기가 유일한 방어다.
# 켜져 있는지: gh api repos/blackshoes1/tripcanvas/branches/main --jq .protected   (docs/deployment-workflow.md)
# main 푸시는 Vercel(웹)과 release.yml(NAS API) 자동 배포로 이어져 **프로덕션에 나간다** — 실수 한 번의 값이 크다.
#
# 켜기:  git config core.hooksPath .githooks
# 우회:  git push --no-verify   (긴급 복구에만. 왜 그랬는지 남길 것)

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "✗ main에 직접 푸시하지 않는다 — 브랜치를 만들고 PR로 넣는다." >&2
      echo "  main merge는 즉시 프로덕션 배포다. 게이트: npm run verify:all" >&2
      echo "  정말 필요하면: git push --no-verify" >&2
      exit 1
      ;;
  esac
done
exit 0
