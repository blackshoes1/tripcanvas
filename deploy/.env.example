# deploy/.env — docker compose가 읽는다. 실제 파일은 Git에 올리지 않는다(§58).
# 운영은 이 값들만으로 뜬다: docker compose -f deploy/docker-compose.yml up -d

POSTGRES_DB=tripcanvas
POSTGRES_USER=tripcanvas
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# 백업 덤프 위치(DB 볼륨과 다른 곳 — NAS의 별도 공유 폴더/Hyper Backup 대상) · 보관 일수
BACKUP_DIR=/volume1/backups/tripcanvas
BACKUP_KEEP_DAYS=30

# ── api 컨테이너 환경 (next/.env.example 참고) ──
# 운영은 넷 다 NEW_BACKEND다(2026-09-04~). 새로 띄우는 staging도 같다 — LEGACY는 Supabase 시절 경로다
TC_MIGRATION_TRIP=NEW_BACKEND
TC_MIGRATION_COLLAB=NEW_BACKEND
TC_MIGRATION_ADAPTIVE=NEW_BACKEND
TC_MIGRATION_PRICING=NEW_BACKEND
# 서버 전용 지도 키(없으면 그 기능만 '미연결' — 서버는 그대로 돈다). iOS 번들 제한 키를 넣으면 403이다
# KAKAO_REST_API_KEY=
# GOOGLE_ROUTES_API_KEY=
# 백업이 이 시간 안에 성공하지 않으면 /api/health가 DEGRADED로 알린다(ops_backup_runs). 비우면 검사하지 않는다
BACKUP_MAX_AGE_HOURS=26
# 점검(읽기 전용) 모드 — 전환 직전 write freeze에만 1로. 쓰기 라우트가 503 MAINTENANCE로 답한다(docs/production-cutover.md)
# TC_READ_ONLY=0
NEXT_PUBLIC_SUPABASE_URL=https://gdnhrwtfidjimtabgovh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_2C-n1YFvE9Cw9B7L7B6Trw_XO3Val5q
# SUPABASE_JWT_SECRET=

# ── 자체 Auth(Phase 8) — 켜려면 둘 다 필요하다 ──
# AUTH_SECRET=
# API_BASE_URL=https://api.example.com          # 이 API의 공개 주소 — 호스트를 옮기면 반드시 함께 바꾼다(better-auth baseURL·메일 링크)
# TRUSTED_ORIGINS=                              # 적으면 기본값(tripcanvas-ai.vercel.app·localhost:8000)은 쓰이지 않는다 — 프로덕션 웹 주소를 꼭 포함
# WEB_BASE_URL=https://tripcanvas-ai.vercel.app # 메일 속 링크가 도착할 웹 주소(비우면 TRUSTED_ORIGINS의 첫 항목)
# REALTIME_URL=wss://api.example.com/ws         # 브라우저·앱이 붙는 실시간 공개 주소(/api/v1/me가 알려 준다)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Trip Canvas <no-reply@example.com>
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# HOTEL_METASEARCH_API_KEY=

# ── docker-compose.caddy.yml을 겹칠 때만 필요하다(도메인 + Caddy 경로) ──
# 오늘의 ingress는 Tailscale Funnel이라 운영에는 필요 없다.
# API_DOMAIN=api.example.com
