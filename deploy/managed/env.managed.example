# 관리형 런타임에 넣을 환경변수 **이름**. 값은 provider 시크릿 저장소에만(파일·저장소·로그에 두지 않는다).
# 어느 provider든 같은 이름이다 — 앱 코드는 호스팅 위치를 모른다(docs/managed-infrastructure.md).

# ── API 앱 ──
DATABASE_URL=                 # 관리형 PostgreSQL. 풀러 주소여도 된다(앱은 세션 상태에 기대지 않는다). sslmode=require — pg의 verify-full 해석에 걸리면 uselibpqcompat=true
AUTH_SECRET=                  # 32자 이상. **실시간 앱과 같은 값** — 다르면 아무도 실시간에 못 붙는다
API_BASE_URL=                 # 이 API의 공개 주소(https://…). better-auth baseURL·메일 링크. 호스트를 옮기면 반드시 함께
TRUSTED_ORIGINS=              # https://tripcanvas-ai.vercel.app,http://localhost:8000 — 적으면 기본값은 쓰이지 않는다
WEB_BASE_URL=                 # https://tripcanvas-ai.vercel.app — 메일 링크가 도착할 웹
REALTIME_URL=                 # wss://<realtime 앱 호스트>/ws — /api/v1/me가 클라이언트에 알려 준다
REALTIME_HEALTH_URL=          # http(s)://<realtime 앱 내부/공개 헬스 주소>/health — /api/health가 LISTEN 상태를 함께 본다
BACKUP_MAX_AGE_HOURS=26       # ops_backup_runs로 백업 최신성을 판정. NAS backup-only 스택이 기록한다
TC_MIGRATION_TRIP=NEW_BACKEND
TC_MIGRATION_COLLAB=NEW_BACKEND
TC_MIGRATION_ADAPTIVE=NEW_BACKEND
TC_MIGRATION_PRICING=NEW_BACKEND
KAKAO_REST_API_KEY=           # 서버 전용(국내 경로·국내 검색). 없으면 그 기능만 '미연결'
GOOGLE_ROUTES_API_KEY=        # 서버 전용(해외 경로). 없으면 직선 추정
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NEXT_PUBLIC_SUPABASE_URL=     # 옛 iOS 앱의 Supabase 토큰을 아직 받는다(compositeVerifier) — 종료 조건은 docs/system-architecture-review.md
SUPABASE_JWT_SECRET=          # 그 프로젝트가 HS256이면
# TC_READ_ONLY=1              # 전환 직전 write freeze에만. 평소에는 넣지 않는다

# ── 실시간 앱 ──
DATABASE_URL=                 # API와 같은 DB
REALTIME_DATABASE_URL=        # **직접** 주소(풀러 아님). 비우면 DATABASE_URL을 쓴다 — 트랜잭션 모드 풀러면 LISTEN이 조용히 죽는다
AUTH_SECRET=                  # API와 같은 값
REALTIME_PORT=3001
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWT_SECRET=
TC_MIGRATION_COLLAB=NEW_BACKEND

# ── 마이그레이션(사람이 돌린다: cd next && npm run db:migrate) ──
MIGRATE_DATABASE_URL=         # 소유자 계정의 직접 주소. 앱 계정과 갈라 둘 수 있으면 가른다
