# tripcanvas-api 환경변수(§57). 실제 값은 .env.local(로컬) 또는 배포 환경의 시크릿에 둔다 — Git에 올리지 않는다(§58).

# ── 독립 PostgreSQL (없으면 새 backend 경로를 쓰지 않는다 — 오늘의 Vercel 배포와 같은 동작) ──
# DATABASE_URL=postgres://tripcanvas:CHANGE_ME@postgres:5432/tripcanvas

# ── 이관 레지스트리(도메인별 source of truth): LEGACY | DUAL_READ | NEW_BACKEND. 기본 LEGACY ──
# TC_MIGRATION_TRIP=LEGACY
# TC_MIGRATION_ADAPTIVE=LEGACY
# TC_MIGRATION_PRICING=LEGACY
# TC_MIGRATION_COLLAB=LEGACY

# ── 자체 Auth (Phase 8). 이 둘이 없으면 꺼진 채로 둔다 — /api/auth/* 는 404고 Supabase 경로만 돈다 ──
# AUTH_SECRET=  # 32자 이상 무작위. openssl rand -base64 48
# API_BASE_URL=https://api.example.com          # 인증·재설정 링크가 이 주소로 만들어진다
# TRUSTED_ORIGINS=  # 브라우저 출처(§72). 비워 두면 tripcanvas-ai.vercel.app·localhost:8000 (cors.ts의 DEFAULT_ORIGINS).
#                  # 적으면 그것만 쓴다 — 프로덕션 주소도 같이 적을 것. * 를 쓰지 않는다

# ── 자체 실시간 사이드카의 공개 주소. 없으면 웹은 예전(Supabase) 실시간을 쓴다 ──
# 협업이 새 DB로 넘어간 뒤에만 의미가 있다 — GET /api/v1/me가 이 값을 보고 웹에 어느 실시간을 쓸지 알려 준다
# REALTIME_URL=wss://api.example.com/ws

# ── 메일(§21). NAS에서 직접 메일 서버를 운영하지 않는다 — 외부 SMTP provider.
# host와 MAIL_FROM이 둘 다 있어야 쓴다. 없으면 링크가 서버 로그로 떨어진다(조용히 삼키지 않는다) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Trip Canvas <no-reply@example.com>

# ── Supabase (Phase A: 토큰을 서버가 직접 검증한다) ──
# 새 프로젝트의 비대칭 키는 ${SUPABASE_URL}/auth/v1/.well-known/jwks.json 에서 받는다. 아무 값도 없으면 레거시 프로젝트로 붙는다
NEXT_PUBLIC_SUPABASE_URL=https://gdnhrwtfidjimtabgovh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_2C-n1YFvE9Cw9B7L7B6Trw_XO3Val5q
# 구형 HS256 토큰까지 받아야 하면 프로젝트의 JWT secret(서버 전용 비밀)
# SUPABASE_JWT_SECRET=

# ── 크론 (레거시 api/track-hotel-prices.js) ──
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# HOTEL_METASEARCH_API_KEY=
